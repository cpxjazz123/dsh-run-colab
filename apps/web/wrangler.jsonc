{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dsh-agent-web",
	"workers_dev": true,
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"services": [
		{
			"binding": "DSH_API",
			"service": "dsh-agent-api"
		}
	],
	// Accounts and sessions for the panel. Create the database once with
	//   pnpm --filter @dsh-agent/web exec wrangler d1 create dsh-auth
	// then replace database_id with the id it prints.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "dsh-auth",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
