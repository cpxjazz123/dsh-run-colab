{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dsh-colab-bridge",
	// Reached only through the dsh-agent-api service binding; the API worker is
	// the public origin for the panel, the Agent UI, and generated images.
	"workers_dev": false,
	"main": "src/index.ts",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"vars": {
		// Set this to the public origin of the dsh-agent-api Worker so the DSH
		// Web UI and generated image links use the origin the browser reached.
		"DSH_PUBLIC_URL": "",
		// Quota project for the Drive API calls (runtime snapshot + DSH home
		// archive). Set it to the project where drive.googleapis.com is enabled.
		"GOOGLE_CLOUD_PROJECT": "uxpilot-clone"
	},
	"secrets": {
		"required": [
			"DSH_BRIDGE_TOKEN",
			"DEEPSEEK_API_KEY",
			"DEEPSEEK_BASE_URL",
			"DEEPSEEK_MODEL",
			"COLAB_OAUTH_TOKEN"
		]
	},
	// User settings survive container recreation: the Worker mirrors every
	// /config and /start body here, and seeds the container with it on boot.
	"kv_namespaces": [
		{
			"binding": "CONFIG_KV",
			"id": "7bd11dee8ba04d9c875d1fd71eba5a22"
		}
	],
	"containers": [
		{
			"class_name": "DshBridgeContainer",
			"image": "./Dockerfile",
			"instance_type": "standard-1",
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DSH_BRIDGE",
				"class_name": "DshBridgeContainer"
			}
		]
	},
	"exports": {
		"DshBridgeContainer": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
